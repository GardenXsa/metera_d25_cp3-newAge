  "guards": [
    {
      "id": "no_travel_during_active_combat",
      "when": {
        "combatActive": true,
        "hostilesAlive": true
      },
      "blockCommands": ["startTravel", "setLocation"],
      "conflictingIntents": ["travel"],
      "reinterpretAs": "combat_escape",
      "promptPatchKey": "intent.prompt.travelDuringCombat",
      "noticeKey": "intent.notice.travelDuringCombat"
    }
  ],
  "messages": {
    "en": {
      "intent.prompt.travelDuringCombat": "The player wants to travel or relocate, but active combat with living hostiles is in progress. Do not execute ordinary travel, setLocation, or startTravel. Treat the player intent as an attempt to withdraw, break through, reposition, or organize an escape inside the combat scene. Explain the combat constraint clearly and offer concrete combat-safe options.",
      "intent.notice.travelDuringCombat": "You are in combat. Ordinary travel is unavailable, but you can try to break through, withdraw, reposition, or give an order."
    },
    "ru": {
      "intent.prompt.travelDuringCombat": "Игрок хочет переместиться или отправиться в путь, но сейчас идет бой с живыми врагами. Не выполняй обычное путешествие, setLocation или startTravel. Трактуй намерение как попытку отступить, прорваться, сменить позицию или организовать отход внутри боевой сцены. Объясни ограничение ясно и предложи конкретные боевые варианты.",
      "intent.notice.travelDuringCombat": "Вы в бою. Обычное путешествие недоступно, но можно попытаться прорваться, отступить, сменить позицию или отдать приказ."
    }
  }
}
